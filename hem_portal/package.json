{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --webpack && node scripts/prepare-standalone.cjs && node scripts/check-standalone.cjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "lint:check": "node scripts/check-lint.cjs",
    "typecheck": "tsc --noEmit",
    "check:env": "node scripts/check-env.cjs",
    "verify": "npm run typecheck && npm run lint:check && npm test",
    "release:check": "npm run verify && npm run build",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "node scripts/smoke-production.cjs"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.108.2",
    "@types/jszip": "^3.4.0",
    "@types/xmldom": "^0.1.34",
    "@xmldom/xmldom": "^0.9.12",
    "dotenv": "^17.4.2",
    "jszip": "^3.10.2",
    "lucide-react": "^1.21.0",
    "next": "16.2.7",
    "next-themes": "^0.4.6",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "pngjs": "7.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
